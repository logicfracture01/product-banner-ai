# ---- secrets -------------------------------------------------------------
# Never commit real values. `.env.example` (checked in) documents the keys the
# app expects; everything else is per-environment.
.env
.env.local
.env.keys
.env.*.local

# ---- dependencies -------------------------------------------------------
node_modules

# ---- build output -------------------------------------------------------
dist
dist-ssr
# Stale build snapshot left in the tree by an earlier packaging step.
isolate

# ---- generated types ----------------------------------------------------
src/convex/_generated

# ---- python (pipeline_py) -----------------------------------------------
__pycache__/
.pytest_cache/
*.pyc

# ---- demo video ---------------------------------------------------------
# Generated by tools/make-demo-video.mjs (headless browser capture + ffmpeg).
# The HTML source of the demo is committed; the encoded MP4 is a build
# artifact, so it is not. See video/README.md.
video/*.mp4
video/*.webm
video/frames

# ---- editor / OS --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.local
*.log
